{
  "name": "cf-pos-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "start": "node server/server.mjs",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create pos-demo-db",
    "db:init": "wrangler d1 execute pos-demo-db --file=./schema.sql --remote",
    "db:init:local": "wrangler d1 execute pos-demo-db --file=./schema.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@cloudflare/workers-types": "^4.20240919.0",
    "better-sqlite3": "^13.0.3",
    "sharp": "^0.35.4",
    "typescript": "^5.6.3",
    "wrangler": "^3.78.0"
  }
}
